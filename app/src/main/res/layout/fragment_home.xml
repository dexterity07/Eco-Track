<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".home">


    <ImageView
        android:id="@+id/dashBoardImg"
        android:layout_width="369dp"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/dashboardbg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.619"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/category"
        android:layout_width="184dp"
        android:layout_height="38dp"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-condensed-medium"
        android:text="CATEGORIES"
        android:textAppearance="@style/TextAppearance.AppCompat.Display1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.092"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dashBoardImg" />

    <ImageView
        android:id="@+id/category1"
        android:layout_width="139dp"
        android:layout_height="149dp"
        android:layout_marginStart="55dp"
        android:layout_marginTop="82dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"

        android:src="@drawable/cat1"
        app:layout_constraintBottom_toTopOf="@+id/category3"
        app:layout_constraintEnd_toStartOf="@+id/category2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dashBoardImg" />

    <ImageView
        android:id="@+id/category3"
        android:layout_width="139dp"
        android:layout_height="149dp"
        android:layout_marginStart="55dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:src="@drawable/cat3"
        app:layout_constraintEnd_toStartOf="@+id/category4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/category1" />

    <ImageView
        android:id="@+id/category5"
        android:layout_width="139dp"
        android:layout_height="149dp"
        android:layout_marginStart="56dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="121dp"
        android:src="@drawable/cat5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/category3"
        app:layout_constraintVertical_bias="1.0" />

    <ImageView
        android:id="@+id/category2"
        android:layout_width="139dp"
        android:layout_height="149dp"
        android:layout_marginTop="82dp"
        android:layout_marginEnd="55dp"
        android:src="@drawable/cat2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.846"
        app:layout_constraintStart_toEndOf="@+id/category1"
        app:layout_constraintTop_toBottomOf="@+id/dashBoardImg" />

    <ImageView
        android:id="@+id/category4"
        android:layout_width="139dp"
        android:layout_height="149dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="55dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/cat4"
        app:layout_constraintBottom_toTopOf="@+id/category6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.869"
        app:layout_constraintStart_toEndOf="@+id/category3"
        app:layout_constraintTop_toBottomOf="@+id/category2" />

    <ImageView
        android:id="@+id/category6"
        android:layout_width="139dp"
        android:layout_height="149dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="55dp"
        android:layout_marginBottom="121dp"
        android:src="@drawable/cat6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.961"
        app:layout_constraintStart_toEndOf="@+id/category5"
        app:layout_constraintTop_toBottomOf="@+id/category4" />

    <ImageView
        android:id="@+id/imageView11"
        android:layout_width="172dp"
        android:layout_height="142dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/logow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.857"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/wasteText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        app:layout_constraintBottom_toBottomOf="@+id/category1"
        app:layout_constraintEnd_toEndOf="@+id/category1"
        app:layout_constraintHorizontal_bias="0.259"
        app:layout_constraintStart_toStartOf="@+id/category1"
        app:layout_constraintTop_toTopOf="@+id/category1"
        app:layout_constraintVertical_bias="0.892" />

    <TextView
        android:id="@+id/polText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        app:layout_constraintBottom_toBottomOf="@+id/category2"
        app:layout_constraintEnd_toEndOf="@+id/category2"
        app:layout_constraintHorizontal_bias="0.246"
        app:layout_constraintStart_toStartOf="@+id/category2"
        app:layout_constraintTop_toTopOf="@+id/category2"
        app:layout_constraintVertical_bias="0.892" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        app:layout_constraintBottom_toBottomOf="@+id/category3"
        app:layout_constraintEnd_toEndOf="@+id/category3"
        app:layout_constraintHorizontal_bias="0.259"
        app:layout_constraintStart_toStartOf="@+id/category3"
        app:layout_constraintTop_toTopOf="@+id/category3"
        app:layout_constraintVertical_bias="0.907" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        app:layout_constraintBottom_toBottomOf="@+id/category4"
        app:layout_constraintEnd_toEndOf="@+id/category4"
        app:layout_constraintHorizontal_bias="0.246"
        app:layout_constraintStart_toStartOf="@+id/category4"
        app:layout_constraintTop_toTopOf="@+id/category4"
        app:layout_constraintVertical_bias="0.9" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        app:layout_constraintBottom_toBottomOf="@+id/category5"
        app:layout_constraintEnd_toEndOf="@+id/category5"
        app:layout_constraintHorizontal_bias="0.308"
        app:layout_constraintStart_toStartOf="@+id/category5"
        app:layout_constraintTop_toTopOf="@+id/category5"
        app:layout_constraintVertical_bias="0.884" />

    <TextView
        android:id="@+id/taskPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:fontFamily="sans-serif-black"
        android:text="0%"
        android:textAppearance="@style/TextAppearance.AppCompat.Display3"
        android:textColor="@color/white"
        app:layout_constraintEnd_toStartOf="@+id/imageView11"
        app:layout_constraintHorizontal_bias="0.485"
        app:layout_constraintStart_toStartOf="@+id/dashBoardImg"
        app:layout_constraintTop_toTopOf="@+id/dashBoardImg" />

</androidx.constraintlayout.widget.ConstraintLayout>